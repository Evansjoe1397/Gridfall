{
  "name": "boardgame",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit",
    "check:rules": "tsx scripts/check-rules.ts",
    "check:replicas": "tsx scripts/check-replica-targeting.ts",
    "check:objects": "tsx scripts/check-object-combat.ts",
    "check:blessed-might": "tsx scripts/check-blessed-might.ts",
    "check:combat-order": "tsx scripts/check-combat-order.ts",
    "check:spirit-combat": "tsx scripts/check-spirit-combat.ts",
    "check:john-fire": "tsx scripts/check-john-fire-presentations.ts",
    "check:spectre-visuals": "tsx scripts/check-spectre-visuals.ts",
    "check:blessing-shield": "tsx scripts/check-blessing-shield.ts",
    "check:consume-range": "tsx scripts/check-consume-range.ts",
    "check:stoic-shell": "tsx scripts/check-stoic-shell.ts",
    "check:lightsaber-duration": "tsx scripts/check-lightsaber-duration.ts",
    "check:obi-wan": "tsx scripts/check-obi-wan.ts",
    "check:chain-lightning": "tsx scripts/check-chain-lightning.ts",
    "check:snowball-effect": "tsx scripts/check-snowball-effect.ts",
    "check:bone-chill": "tsx scripts/check-bone-chill.ts",
    "check:redirect-objects": "tsx scripts/check-redirect-objects.ts",
    "check:graveyard": "tsx scripts/check-graveyard.ts",
    "check:sap": "tsx scripts/check-sap.ts",
    "check:dakkoth": "tsx scripts/check-dakkoth.ts",
    "check:combat-summary-export": "tsx scripts/check-combat-summary-export.ts",
    "check:wreckna-tomb-icon": "tsx scripts/check-wreckna-tomb-icon.ts",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/three": "^0.185.1",
    "concurrently": "^10.0.3",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@colyseus/sdk": "^0.17.43",
    "@colyseus/ws-transport": "^0.17.13",
    "colyseus": "^0.17.10",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "three": "^0.183.2",
    "xstate": "^5.32.4",
    "zod": "^4.4.3"
  }
}

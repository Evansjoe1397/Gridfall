# Central statistics API, shared by all hosts. Public URL; never put the write key in VITE_*.
# Optional; omitted by default so all hosts use the URL bundled with the game.
# GRIDFALL_STATS_URL=https://gridfall-statistics.arigusee.workers.dev
GRIDFALL_STATS_WRITE_KEY=
# Only for manually importing old summaries; ordinary hosts do not need this key.
GRIDFALL_STATS_IMPORT_KEY=
# Only for deleting matches from the history menu.
GRIDFALL_STATS_ADMIN_KEY=
# Keep this folder on a persistent disk on hosted servers.
GRIDFALL_STATS_OUTBOX=.gridfall-history
# Optional deployment override; otherwise the server detects the Git SHA and dirty state.
# GRIDFALL_COMMIT=
